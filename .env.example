# MongoDB connection string (must include the database name)
# Legacy source — only used by scripts/migrate_mongo_to_postgres.py and
# scripts/create_super_admin_mongo.py during the migration window.
MONGO_URI=mongodb://localhost:27017/aion2026
# MONGO_DB=aion2026
# Keep the Mongo lifespan active alongside Postgres (default false).
MONGO_RETAIN=false

# PostgreSQL — primary persistence layer (async sqlalchemy_url)
# Driver form for async SQLAlchemy:
DATABASE_URL=postgresql+asyncpg://aion:aion@localhost:5432/aion2026
SQLA_ECHO=false

# Secret key used to sign JWTs - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Comma-separated list of allowed CORS origins, or * for all
CORS_ORIGINS=*

# Uvicorn port
PORT=5000

# Environment name (development/production) and log level
ENVIRONMENT=development
LOG_LEVEL=INFO

# Rate limiting (slowapi). Enable in production.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=20/minute
RATE_LIMIT_LOGIN=10/minute

# Initial Super Admin (used by scripts/create_super_admin.py seeder)
# Run: .venv\Scripts\python scripts\create_super_admin.py
INITIAL_ADMIN_ID=SA1
INITIAL_ADMIN_NAME=Root
INITIAL_ADMIN_PASSWORD=your_secure_password_here
