# MongoDB connection string (must include the database name)
MONGO_URI=mongodb://localhost:27017/aion2026

# Optional: explicitly name the database when it is not part of MONGO_URI
# MONGO_DB=aion2026

# Secret key used to sign JWTs - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Comma-separated list of allowed CORS origins, or * for all
CORS_ORIGINS=*

# Uvicorn port
PORT=5000

# Environment name (development/production) and log level
ENVIRONMENT=development
LOG_LEVEL=INFO

# Rate limiting (slowapi). Enable in production.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=20/minute
RATE_LIMIT_LOGIN=10/minute
